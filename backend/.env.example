# PathPilot backend — required environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Server port (Render sets this automatically — keep 8080 as default)
PORT=8080

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Firebase service account — paste the ENTIRE downloaded JSON on ONE line
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Allowed CORS origin (your Vercel frontend URL)
ALLOWED_ORIGIN=https://your-frontend.vercel.app
